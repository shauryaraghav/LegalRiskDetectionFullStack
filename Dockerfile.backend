FROM python:3.12-slim
LABEL org.opencontainers.image.source="https://github.com/shauryaraghav/LegalRiskDetectionFullStack"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
# Patch OS packages that have fixes available (keeps the Trivy gate green).
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/* \
    && useradd -m app
COPY requirements-server.txt .
RUN pip install --no-cache-dir -r requirements-server.txt
COPY --chown=app:app src ./src
COPY --chown=app:app server ./server
COPY --chown=app:app data ./data
COPY --chown=app:app models ./models
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 CMD python -c "import urllib.request as u; u.urlopen('http://localhost:8000/api/health')"
CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers"]
